{
  "expo": {
    "name": "App de Captura de Vídeo",
    "slug": "App de Captura de Vídeo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir acesso às fotos para salvar vídeos.",
          "savePhotosPermission": "Permitir salvar vídeos gravados na galeria.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-camera",
      "expo-video"
    ]
  }
}